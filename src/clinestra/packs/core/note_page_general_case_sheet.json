{
  "def_kind": "note_page",
  "key": "general_case_sheet",
  "version": 1,
  "name": "General case sheet",
  "config": {
    "page_type": "case_sheet",
    "blocks": [
      {
        "key": "chief_complaint",
        "label": "Chief complaint",
        "input_type": "free_text",
        "required": true
      },
      {
        "key": "history",
        "label": "History of present illness",
        "input_type": "narrative"
      },
      {
        "key": "bp_systolic",
        "label": "BP systolic",
        "input_type": "number",
        "observation_code": "bp_systolic",
        "unit": "mmHg"
      },
      {
        "key": "bp_diastolic",
        "label": "BP diastolic",
        "input_type": "number",
        "observation_code": "bp_diastolic",
        "unit": "mmHg"
      },
      {
        "key": "pulse",
        "label": "Pulse",
        "input_type": "number",
        "observation_code": "pulse",
        "unit": "/min"
      },
      {
        "key": "weight",
        "label": "Weight",
        "input_type": "number",
        "observation_code": "weight",
        "unit": "kg"
      },
      {
        "key": "examination",
        "label": "Examination",
        "input_type": "narrative"
      },
      {
        "key": "assessment_plan",
        "label": "Assessment and plan",
        "input_type": "narrative",
        "required": true
      }
    ],
    "exports_to": [
      "prescription",
      "clinical_report"
    ]
  }
}