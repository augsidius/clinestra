{
  "def_kind": "note_page",
  "key": "opd_triage",
  "version": 1,
  "name": "OPD vitals and triage",
  "config": {
    "page_type": "case_sheet",
    "blocks": [
      {
        "key": "bp_systolic",
        "label": "BP systolic",
        "input_type": "number",
