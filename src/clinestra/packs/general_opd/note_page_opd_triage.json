        "unit": "mmHg"
      },
      {
        "key": "bp_diastolic",
        "label": "BP diastolic",
        "input_type": "number",
        "observation_code": "bp_diastolic",
        "unit": "mmHg"
      },
      {
        "key": "pulse",
        "label": "Pulse",
        "input_type": "number",
        "observation_code": "pulse",
        "unit": "/min"
      },
      {
        "key": "temperature",
        "label": "Temperature",
        "input_type": "number",
        "observation_code": "temperature",
        "unit": "°C"
      },
      {
        "key": "resp_rate",
        "label": "Respiratory rate",
        "input_type": "number",
        "observation_code": "resp_rate",
        "unit": "/min"
      },
      {
        "key": "spo2",
        "label": "SpO2",
        "input_type": "number",
        "observation_code": "spo2",
        "unit": "%"
