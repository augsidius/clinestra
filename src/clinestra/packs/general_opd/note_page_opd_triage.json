      {
        "key": "weight",
        "label": "Weight",
        "input_type": "number",
        "observation_code": "weight",
        "unit": "kg"
      },
      {
        "key": "height",
        "label": "Height",
        "input_type": "number",
        "observation_code": "height",
        "unit": "cm"
      },
      {
        "key": "visit_priority",
